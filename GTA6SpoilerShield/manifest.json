{
  "manifest_version": 3,
  "name": "GTA 6 Spoiler Shield",
  "version": "1.0.0",
  "description": "Automatically detects and hides GTA 6 spoilers across websites.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "GTA 6 Spoiler Shield",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}